<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/typeSpinner" android:text="@string/centres_device_label" />
    <Spinner android:id="@+id/typeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:spinnerMode="dropdown" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/brandInput" android:text="@string/item_brand" />
    <EditText android:id="@+id/brandInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textCapWords" android:textSize="16sp" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/modelInput" android:text="@string/item_model" />
    <EditText android:id="@+id/modelInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="text" android:textSize="16sp" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/conditionSpinner" android:text="@string/item_condition" />
    <Spinner android:id="@+id/conditionSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:spinnerMode="dropdown" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/quantityInput" android:text="@string/item_quantity" />
    <EditText android:id="@+id/quantityInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:textSize="16sp" android:importantForAutofill="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:labelFor="@id/notesInput" android:text="@string/item_notes" />
    <EditText android:id="@+id/notesInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textMultiLine" android:textSize="16sp" android:importantForAutofill="no" />
    <com.google.android.material.button.MaterialButton android:id="@+id/continueButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="48dp" android:text="@string/item_continue" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
